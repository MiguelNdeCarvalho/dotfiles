# Set Historic file
HISTSIZE=999999999
HISTFILE="$HOME/.zsh_history"
SAVEHIST=$HISTSIZE

# Add mise
eval "$(mise activate zsh)"

# Alias
alias vim=nvim

# Set completation
autoload -Uz compinit && compinit

# Start Oh My Posh
eval "$(oh-my-posh init zsh --config $HOME/.config/oh-my-posh/zen.toml)"

# Add Zoxide
eval "$(zoxide init --cmd cd zsh)"

# Add FZF
eval "$(fzf --zsh)"

# Add Atuin
eval "$(atuin init zsh)"

# Add Terrabutler
eval "$(terrabutler completion zsh)"

# Some ENV variables
export EDITOR=nvim

# Some Alias
alias kubectl=kubecolor
alias k=kubecolor
alias ..="cd .."
alias l="eza --icons --git"
alias ls="eza -lha --icons --git"
alias cat="bat"
alias '??'='opencode run "$*" --model deepseek/deepseek-chat'

# kubectl completations
source <(kubectl completion zsh)
compdef kubecolor=kubectl
